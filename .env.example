# Copy to `.env` (git-ignored) and fill in real values before `docker compose up`.

# --- Public URL of the deployed app (used for CORS + cookie/redirects) ---
# Must be the HTTPS origin the browser uses, e.g. https://bookitnow.example.com
PUBLIC_URL=https://yourdomain.com

# --- PostgreSQL ---
POSTGRES_DB=bookitnowv2
POSTGRES_USER=bookitnow
POSTGRES_PASSWORD=change-me-strong-password
