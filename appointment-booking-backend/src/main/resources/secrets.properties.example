# OPTIONAL local overrides — the app runs without this file.
#
# Copy to `secrets.properties` (git-ignored, never commit it) and uncomment only
# what you want to change. The same keys can also be set as environment variables.

# --- Use your own PostgreSQL instead of the embedded H2 database ---
# DB_URL=jdbc:postgresql://localhost:5432/bookitnowv2?sslmode=disable
# DB_USERNAME=postgres
# DB_PASSWORD=changeme
# HIBERNATE-DDL=update

# --- File storage paths (default: uploads/avatars inside the backend folder) ---
# AVATAR-DIRECTORY=/absolute/path/to/uploads/avatars
# AVATAR-USER-DIRECTORY=/absolute/path/to/uploads/avatars/useravatars

# --- Public base URL of the backend (used in avatar URLs) ---
# FRONTEND-IP-ADDRESS=http://localhost:8080
