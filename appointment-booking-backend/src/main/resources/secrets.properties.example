# Template for secrets.properties (local development only).
#
# Copy this file to `secrets.properties` and fill in real values:
#     cp secrets.properties.example secrets.properties
#
# `secrets.properties` is git-ignored and MUST NOT be committed.
#
# In PRODUCTION do NOT ship this file. Provide the same keys as environment
# variables or Docker secrets, e.g.:
#     export DB_PASSWORD=...           (Linux/macOS)
#     docker run -e DB_PASSWORD=... ... (Docker)
# The backend reads them via the ${...} placeholders in application.properties.

# --- Database ---
DRIVER_CLASSNAME=org.postgresql.Driver
DB_URL=jdbc:postgresql://localhost:5432/bookitnowv2?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=changeme
HIBERNATE-DDL=update
HIBERNATE-DIALECT=org.hibernate.dialect.PostgreSQLDialect

# --- TLS certificate for the database (paste the PEM between the markers) ---
SSL-CA=-----BEGIN CERTIFICATE-----\
...replace with your CA certificate...\
-----END CERTIFICATE-----

# --- Elasticsearch ---
ELASTIC-PASSWORD=changeme
ELASTIC-TRUSTSTORE-PATH=/absolute/path/to/elastic/truststore.p12

# --- File storage paths ---
AVATAR-DIRECTORY=/absolute/path/to/uploads/avatars
AVATAR-USER-DIRECTORY=/absolute/path/to/uploads/avatars/useravatars
AVATAR-EMPLOYEE-DIRECTORY=/absolute/path/to/uploads/avatars/employeeavatars
AVATAR-COMPANY-DIRECTORY=/absolute/path/to/uploads/avatars/companyavatars

# --- Networking ---
FRONTEND-IP-ADDRESS=http://localhost:8080
# Comma-separated list of browser origins allowed by CORS (prod profile only).
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# --- Active Spring profile: dev | prod ---
SPRING_PROFILES_ACTIVE=dev
